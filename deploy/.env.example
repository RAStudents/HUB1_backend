# Public DNS must point this hostname to the VPS.
DOMAIN=hub.acmenra.studio

POSTGRES_DB=hub
POSTGRES_USER=hub
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=replace_with_a_random_hex_secret
JWT_SECRET=replace_with_a_different_random_hex_secret

# Optional Yandex OAuth. Register this exact callback URL in the OAuth app:
# https://hub.acmenra.studio/api/auth/yandex/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Optional SMTP for invitation emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=10
